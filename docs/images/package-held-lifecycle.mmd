    H --> T["만료 sweep<br/>HeldExpiryScheduler"]

    C --> C2["좌석 SOLD<br/>예약 CONFIRMED<br/>DB 커밋 · @Version"]
    X --> X2["좌석 AVAILABLE<br/>예약 CANCELLED<br/>DB 커밋 · @Version"]
    T --> T2["좌석 AVAILABLE<br/>예약 EXPIRED<br/>건별 tx 커밋"]

    C2 --> C3["커밋 후 Redis<br/>DECR active<br/>revoke entry"]
    X2 --> X3["커밋 후 Redis<br/>SADD avail<br/>DECR active<br/>revoke entry"]
    T2 --> T3["커밋 후 Redis<br/>SADD avail<br/>DECRBY active"]

    classDef afterCommit fill:#E1F5EE,stroke:#0F6E56,color:#085041;
